{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && sh scripts/check-build.sh",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p . && tsc -p worker",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@club/db": "workspace:*",
    "@club/shared": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vitest": "~4.1.12",
    "wrangler": "^4.163.0"
  }
}
