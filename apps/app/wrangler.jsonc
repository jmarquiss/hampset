{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hampset-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Better Auth uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "app.hampset.co.uk", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hampset",
      // Both Workers use the same database.
      "database_id": "cd35627b-89fe-42e6-b524-08d45bb66302",
      "migrations_dir": "../../packages/db/drizzle",
    },
  ],
  // Each schedule runs the job in worker/crons/ with the same schedule.
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    // Local dev overrides this in .dev.vars.
    "APP_URL": "https://app.hampset.co.uk",
  },
  "observability": { "enabled": true },
}
