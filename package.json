{
  "name": "hampset",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "concurrently -n site,app,admin -c green,blue,magenta \"pnpm --filter site dev\" \"pnpm --filter app dev\" \"wait-on -t 60s tcp:localhost:5174 && pnpm --filter admin dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @club/db generate",
    "db:migrate:local": "pnpm --filter app db:migrate:local",
    "db:migrate:remote": "pnpm --filter app db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "wait-on": "^9.5.1"
  }
}
