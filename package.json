{
  "name": "hampset",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "concurrently -n site,app,admin -c green,blue,magenta \"pnpm --filter site dev\" \"pnpm --filter app dev\" \"wait-on -t 60s tcp:localhost:5174 && pnpm --filter admin dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "ls-lint && eslint . --max-warnings 0",
    "lint:fix": "ls-lint && eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @club/db generate",
    "db:migrate:local": "pnpm --filter app db:migrate:local",
    "db:migrate:remote": "pnpm --filter app db:migrate:remote"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-comment-length": "^2.3.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-validate-jsx-nesting": "^0.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "wait-on": "^9.5.1"
  }
}
