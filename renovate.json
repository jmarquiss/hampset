{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "timezone": "Europe/London",
  "schedule": ["* 0-5 * * 1"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": { "enabled": true, "automerge": true },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates once CI passes, except for 0.x versions",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Keep the stable ESLint toolchain in one PR; 0.x plugins stay separate so they don't block automerge",
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "eslint-*",
        "@eslint-react/**",
        "typescript-eslint",
        "@typescript-eslint/**"
      ],
      "matchCurrentVersion": "!/^v?0\\./"
    },
    {
      "description": "Keep the Workers toolchain in one PR",
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "@cloudflare/**"]
    },
    {
      "description": "drizzle-kit must stay in step with drizzle-orm",
      "groupName": "drizzle",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"]
    },
    {
      "description": "Group GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
